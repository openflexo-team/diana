	<DropDown index="13" data="data.layoutFill" name="Fill" format="object.name" localize="true"
		width="120" iteratorClassName="org.openflexo.diana.layout.GridBagFill" autoSelectFirstRow="true"
		constraints="twocols(expandHorizontally=true;expandVertically=false;index=13;insetsBottom=0;insetsLeft=2;insetsRight=2;insetsTop=0;location=right)" />

	<Label name="AnchorLabel" index="14" localize="true" align="left" label="layout_anchor"
		constraints="twocols(expandHorizontally=false;expandVertically=false;index=14;insetsBottom=0;insetsLeft=2;insetsRight=2;insetsTop=0;location=left)" />
	<DropDown index="15" data="data.layoutAnchor" name="Anchor" format="object.name" localize="true"
